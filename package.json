{
  "name": "caption-bridge-workspace",
  "version": "0.1.1",
  "private": true,
  "description": "Caption Bridge workspace commands",
  "packageManager": "bun@1.3.14",
  "workspaces": [".", "apps/*", "packages/*"],
  "overrides": {
    "array-includes": "3.1.8"
  },
  "scripts": {
    "clean:build": "node scripts/clean-build-artifacts.mjs --prune-rust",
    "clean:build:rust": "node scripts/clean-build-artifacts.mjs --prune-rust",
    "clean:build:temporary": "node scripts/clean-build-artifacts.mjs --temporary-only",
    "dev": "bun --filter=@caption-bridge/desktop run dev",
    "dev:web": "bun --filter=@caption-bridge/desktop run dev",
    "build": "node scripts/clean-build-artifacts.mjs && bun --filter=@caption-bridge/desktop run build",
    "install:macos-native-app": "node scripts/install-macos-native-app.mjs",
    "package:native": "node scripts/package-native-release.mjs",
    "typecheck": "bun --filter=@caption-bridge/desktop run typecheck && bun --filter=@caption-bridge/inference-server-core run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun --filter=@caption-bridge/desktop run test",
    "test:watch": "bun --filter=@caption-bridge/desktop run test:watch",
    "test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/desktop",
    "gateway:dev": "bun --filter=@caption-bridge/inference-gateway run dev",
    "gateway:start": "bun --filter=@caption-bridge/inference-gateway run start",
    "gateway:build": "node scripts/clean-build-artifacts.mjs && bun --filter=@caption-bridge/inference-gateway run build",
    "gateway:test": "bun --filter=@caption-bridge/inference-gateway run test",
    "gateway:test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/inference-gateway",
    "core:test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/inference-server-core",
    "azookey-reading:typecheck": "bun --filter=@caption-bridge/azookey-reading run typecheck",
    "azookey-reading:test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/azookey-reading",
    "dictionaries:typecheck": "bun --filter=@caption-bridge/dictionaries run typecheck",
    "dictionaries:test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/dictionaries",
    "sentence-boundary:typecheck": "bun --filter=@caption-bridge/sentence-boundary run typecheck",
    "sentence-boundary:test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/sentence-boundary",
    "azookey-compare:dev": "bun --filter=@caption-bridge/azookey-compare run dev",
    "azookey-compare:typecheck": "bun --filter=@caption-bridge/azookey-compare run typecheck",
    "azookey-compare:test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/azookey-compare",
    "azookey-compare:build": "bun --filter=@caption-bridge/azookey-compare run build",
    "azookey-compare:deploy": "bun --filter=@caption-bridge/azookey-compare run deploy",
    "azookey-compare:verify:deploy": "node scripts/verify-azookey-compare-deploy.mjs",
    "vad-lab:dev": "bun --filter=@caption-bridge/vad-lab run dev",
    "vad-lab:typecheck": "bun --filter=@caption-bridge/vad-lab run typecheck",
    "vad-lab:test": "bun --filter=@caption-bridge/vad-lab run test",
    "vad-lab:build": "bun --filter=@caption-bridge/vad-lab run build",
    "vad-lab:deploy": "bun --filter=@caption-bridge/vad-lab run deploy",
    "access:setup": "node scripts/setup-cloudflare-access.mjs",
    "access:verify": "bun scripts/verify-cloudflare-hosted.mjs",
    "assets:verify": "node scripts/verify-generated-assets.mjs --require-tracked",
    "verify:caption-quality": "node scripts/verify-caption-quality.mjs",
    "verify:greeting-caption": "node scripts/verify-greeting-live-caption.mjs",
    "verify:ui": "node scripts/capture-ui-screenshots.mjs --exercise-recovery",
    "verify:recognition": "node scripts/recognition-integration.mjs",
    "native:metrics": "bun scripts/benchmark-native-runtime.mjs fixture",
    "web:metrics": "bun scripts/benchmark-web-audio-runtime.mjs",
    "worker:metrics": "bun scripts/benchmark-worker-audio-runtime.mjs",
    "parapper:install": "bun --cwd=packages/parapper-asr install --frozen-lockfile",
    "parapper:dev": "bun --cwd=packages/parapper-asr run dev",
    "parapper:tauri": "bun --cwd=packages/parapper-asr run tauri",
    "parapper:check": "bun --cwd=packages/parapper-asr run check",
    "worker:dev": "bun --filter=@caption-bridge/cloudflare-worker-server run dev",
    "worker:typecheck": "bun --filter=@caption-bridge/cloudflare-worker-server run typecheck",
    "worker:test": "bun --filter=@caption-bridge/cloudflare-worker-server run test",
    "worker:test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/cloudflare-worker-server",
    "worker:metrics:analyze": "bun scripts/analyze-azookey-metrics.mjs",
    "worker:deploy": "bun --filter=@caption-bridge/cloudflare-worker-server run deploy",
    "mcp:cloudflare": "node scripts/setup-cursor-cloudflare-mcp.mjs",
    "parapper:lint": "bun --cwd=packages/parapper-asr run lint",
    "parapper:typecheck": "bun --cwd=packages/parapper-asr run typecheck",
    "parapper:test:ui": "bun --cwd=packages/parapper-asr run test:ui",
    "parapper:test:coverage": "node scripts/run-coverage-locked.mjs parapper",
    "parapper:rust:fmt": "bun --cwd=packages/parapper-asr run rust:fmt",
    "parapper:rust:lint": "bun --cwd=packages/parapper-asr run rust:lint",
    "parapper:rust:test": "bun --cwd=packages/parapper-asr run test",
    "rust:azookey:test": "AZOOKEY_DICTIONARY_ROOT=submodules/azooKey_dictionary_storage/Dictionary cargo test --manifest-path packages/azookey-rust/Cargo.toml",
    "rust:azookey:lint": "cargo clippy --manifest-path packages/azookey-rust/Cargo.toml --all-targets -- -D warnings",
    "rust:azookey:fmt": "cargo fmt --manifest-path packages/azookey-rust/Cargo.toml -- --check",
    "rust:input-lm:test": "cargo test --manifest-path packages/input-lm-rust/Cargo.toml",
    "rust:input-lm:lint": "cargo clippy --manifest-path packages/input-lm-rust/Cargo.toml --all-targets -- -D warnings",
    "rust:input-lm:fmt": "cargo fmt --manifest-path packages/input-lm-rust/Cargo.toml -- --check",
    "rust:zenz-verifier:test": "cargo test --manifest-path packages/zenz-verifier-rust/Cargo.toml --no-default-features",
    "rust:zenz-verifier:lint": "cargo clippy --manifest-path packages/zenz-verifier-rust/Cargo.toml --all-targets --no-default-features -- -D warnings",
    "rust:zenz-verifier:fmt": "cargo fmt --manifest-path packages/zenz-verifier-rust/Cargo.toml -- --check",
    "rust:zenz-verifier:candle": "cargo test --manifest-path packages/zenz-verifier-rust/Cargo.toml --all-features && cargo clippy --manifest-path packages/zenz-verifier-rust/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:vibrato:test": "cargo test --manifest-path packages/vibrato/core/Cargo.toml && cargo test --manifest-path packages/vibrato/wasm/Cargo.toml",
    "rust:vibrato:wasm:build": "cargo build --locked --manifest-path packages/vibrato/wasm/Cargo.toml --target wasm32-unknown-unknown --release",
    "rust:vibrato:lint": "cargo clippy --manifest-path packages/vibrato/core/Cargo.toml --all-targets -- -D warnings && cargo clippy --manifest-path packages/vibrato/wasm/Cargo.toml --all-targets -- -D warnings",
    "rust:vibrato:fmt": "cargo fmt --manifest-path packages/vibrato/core/Cargo.toml -- --check && cargo fmt --manifest-path packages/vibrato/wasm/Cargo.toml -- --check",
    "rust:wasm:fmt": "cargo fmt --manifest-path packages/azookey-wasm/Cargo.toml -- --check",
    "rust:wasm:lint": "cargo clippy --manifest-path packages/azookey-wasm/Cargo.toml --all-targets -- -D warnings",
    "rust:wasm:test": "cargo test --manifest-path packages/azookey-wasm/Cargo.toml",
    "rust:wasm:build": "cargo build --locked --manifest-path packages/azookey-wasm/Cargo.toml --target wasm32-unknown-unknown --release",
    "vibrato:wasm:build": "node scripts/build-vibrato-wasm.mjs --bindgen",
    "mobile:flutter:coverage": "make -C apps/mobile coverage",
    "rust:mobile:fmt": "make -C apps/mobile rust-format",
    "rust:mobile:lint": "make -C apps/mobile rust-lint",
    "rust:mobile:test": "make -C apps/mobile rust-test",
    "rust:mobile:build": "make -C apps/mobile rust-build",
    "rust:native:fmt": "cargo fmt --manifest-path apps/native/Cargo.toml --all -- --check",
    "rust:native:lint": "cargo clippy --locked --manifest-path apps/native/Cargo.toml --all-targets -- -D warnings",
    "rust:native:test": "cargo test --locked --manifest-path apps/native/Cargo.toml",
    "rust:native:build": "cargo build --locked --release --manifest-path apps/native/Cargo.toml",
    "test:build-cleanup": "node --test scripts/build-azookey-dictionary.test.mjs scripts/clean-build-artifacts.test.mjs scripts/run-coverage-locked.test.mjs scripts/run-quality-gate-locked.test.mjs scripts/verify-ci-local-gates.test.mjs scripts/verify-mobile-coverage.test.mjs scripts/verify-generated-assets.test.mjs scripts/verify-azookey-wasm-parity.test.mjs scripts/build-azookey-wasm.test.mjs scripts/install-macos-native-app.test.mjs scripts/package-native-release.test.mjs scripts/setup-cursor-cloudflare-mcp.test.mjs scripts/setup-cloudflare-access.test.mjs scripts/verify-cloudflare-hosted.test.mjs scripts/verify-azookey-compare-deploy.test.mjs scripts/compare-dev-asr-access-proxy.test.mjs scripts/partial-window-cpu-benchmark.test.mjs scripts/benchmark-native-runtime.test.mjs scripts/verify-greeting-live-caption.test.mjs scripts/verify-caption-quality.test.mjs scripts/judge-live-session.test.mjs scripts/probe-worker-one-completion.test.mjs scripts/run-timed-quality-steps.test.mjs",
    "check:all": "node scripts/run-quality-gate-locked.mjs",
    "check:all:unlocked": "node scripts/run-timed-quality-steps.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "binaryen": "132.0.0"
  }
}

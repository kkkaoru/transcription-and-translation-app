{
  "name": "caption-bridge-workspace",
  "version": "0.1.1",
  "private": true,
  "description": "Caption Bridge workspace commands",
  "packageManager": "bun@1.3.14",
  "workspaces": [".", "apps/*", "packages/*"],
  "overrides": {
    "array-includes": "3.1.8"
  },
  "scripts": {
    "clean:build": "node scripts/clean-build-artifacts.mjs --prune-rust",
    "clean:build:rust": "node scripts/clean-build-artifacts.mjs --prune-rust",
    "clean:build:temporary": "node scripts/clean-build-artifacts.mjs --temporary-only",
    "sidecar:build": "node scripts/clean-build-artifacts.mjs && bun run scripts/build-sidecar.ts && node scripts/clean-build-artifacts.mjs --temporary-only",
    "dev": "bun run sidecar:build && bun --filter=@caption-bridge/desktop run tauri:dev",
    "dev:web": "bun --filter=@caption-bridge/desktop run dev",
    "build": "node scripts/clean-build-artifacts.mjs && bun --filter=@caption-bridge/desktop run build",
    "build:app": "bun run tauri:build",
    "build:app:dmg": "bun run sidecar:build && node scripts/run-tauri-build.mjs --dmg",
    "build:app:release": "bun run sidecar:build && node scripts/build-tauri-release.mjs",
    "typecheck": "bun --filter=@caption-bridge/desktop run typecheck && bun --filter=@caption-bridge/inference-server-core run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun --filter=@caption-bridge/desktop run test",
    "test:watch": "bun --filter=@caption-bridge/desktop run test:watch",
    "test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/desktop",
    "gateway:dev": "bun --filter=@caption-bridge/inference-gateway run dev",
    "gateway:start": "bun --filter=@caption-bridge/inference-gateway run start",
    "gateway:build": "node scripts/clean-build-artifacts.mjs && bun --filter=@caption-bridge/inference-gateway run build",
    "gateway:test": "bun --filter=@caption-bridge/inference-gateway run test",
    "gateway:test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/inference-gateway",
    "core:test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/inference-server-core",
    "azookey-compare:dev": "bun --filter=@caption-bridge/azookey-compare run dev",
    "azookey-compare:typecheck": "bun --filter=@caption-bridge/azookey-compare run typecheck",
    "azookey-compare:test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/azookey-compare",
    "azookey-compare:build": "bun --filter=@caption-bridge/azookey-compare run build",
    "check:single-app": "node scripts/check-single-app.mjs",
    "assets:verify": "node scripts/verify-generated-assets.mjs --require-tracked",
    "check:macos-autoswitch": "bash scripts/verify-macos-autoswitch.sh",
    "check:macos-signing": "node scripts/check-macos-signing.mjs",
    "verify:tauri": "node scripts/tauri-smoke.mjs",
    "verify:tauri:build": "node scripts/tauri-smoke.mjs --build",
    "verify:tauri:ui": "node scripts/tauri-smoke.mjs --ui --exercise-capture",
    "verify:tauri:build:ui": "node scripts/tauri-smoke.mjs --build --ui --exercise-capture",
    "verify:ui": "node scripts/capture-ui-screenshots.mjs --exercise-recovery",
    "verify:recognition": "node scripts/recognition-integration.mjs",
    "parapper:install": "bun --cwd=packages/parapper-asr install --frozen-lockfile",
    "parapper:dev": "bun --cwd=packages/parapper-asr run dev",
    "parapper:tauri": "bun --cwd=packages/parapper-asr run tauri",
    "parapper:check": "bun --cwd=packages/parapper-asr run check",
    "worker:dev": "bun --filter=@caption-bridge/cloudflare-worker-server run dev",
    "worker:typecheck": "bun --filter=@caption-bridge/cloudflare-worker-server run typecheck",
    "worker:test": "bun --filter=@caption-bridge/cloudflare-worker-server run test",
    "worker:test:coverage": "node scripts/run-coverage-locked.mjs @caption-bridge/cloudflare-worker-server",
    "worker:deploy": "bun --filter=@caption-bridge/cloudflare-worker-server run deploy",
    "parapper:lint": "bun --cwd=packages/parapper-asr run lint",
    "parapper:typecheck": "bun --cwd=packages/parapper-asr run typecheck",
    "parapper:test:ui": "bun --cwd=packages/parapper-asr run test:ui",
    "parapper:test:coverage": "node scripts/run-coverage-locked.mjs parapper",
    "parapper:rust:fmt": "bun --cwd=packages/parapper-asr run rust:fmt",
    "parapper:rust:lint": "bun --cwd=packages/parapper-asr run rust:lint",
    "parapper:rust:test": "bun --cwd=packages/parapper-asr run test",
    "rust:azookey:test": "AZOOKEY_DICTIONARY_ROOT=submodules/azooKey_dictionary_storage/Dictionary cargo test --manifest-path packages/azookey-rust/Cargo.toml",
    "rust:azookey:lint": "cargo clippy --manifest-path packages/azookey-rust/Cargo.toml --all-targets -- -D warnings",
    "rust:azookey:fmt": "cargo fmt --manifest-path packages/azookey-rust/Cargo.toml -- --check",
    "rust:input-lm:test": "cargo test --manifest-path packages/input-lm-rust/Cargo.toml",
    "rust:input-lm:lint": "cargo clippy --manifest-path packages/input-lm-rust/Cargo.toml --all-targets -- -D warnings",
    "rust:input-lm:fmt": "cargo fmt --manifest-path packages/input-lm-rust/Cargo.toml -- --check",
    "rust:vibrato:test": "cargo test --manifest-path packages/vibrato-wasm/Cargo.toml",
    "rust:vibrato:lint": "cargo clippy --manifest-path packages/vibrato-wasm/Cargo.toml --all-targets -- -D warnings",
    "rust:vibrato:fmt": "cargo fmt --manifest-path packages/vibrato-wasm/Cargo.toml -- --check",
    "rust:wasm:fmt": "cargo fmt --manifest-path packages/azookey-wasm/Cargo.toml -- --check",
    "rust:wasm:lint": "cargo clippy --manifest-path packages/azookey-wasm/Cargo.toml --all-targets -- -D warnings",
    "rust:wasm:test": "cargo test --manifest-path packages/azookey-wasm/Cargo.toml",
    "rust:wasm:build": "cargo build --locked --manifest-path packages/azookey-wasm/Cargo.toml --target wasm32-unknown-unknown --release",
    "vibrato:wasm:build": "node scripts/build-vibrato-wasm.mjs --bindgen",
    "rust:fmt": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all -- --check",
    "rust:lint": "node scripts/rust-lint.mjs",
    "rust:desktop:test": "node scripts/run-desktop-rust-test.mjs",
    "test:build-cleanup": "node --test scripts/build-azookey-dictionary.test.mjs scripts/clean-build-artifacts.test.mjs scripts/run-coverage-locked.test.mjs scripts/check-macos-signing.test.mjs scripts/verify-generated-assets.test.mjs scripts/run-tauri-build.test.mjs scripts/run-desktop-tauri-build.test.mjs scripts/run-desktop-rust-test.test.mjs",
    "check:all": "bun run lint && bun run format:check && bun run check:single-app && bun run assets:verify && bun run test:build-cleanup && bun run typecheck && bun run azookey-compare:typecheck && bun run test:coverage && bun run core:test:coverage && bun run azookey-compare:test:coverage && bun run gateway:build && bun run gateway:test:coverage && bun run worker:typecheck && bun run worker:test:coverage && bun run assets:verify && bun run parapper:lint && bun run parapper:typecheck && bun run parapper:test:ui && bun run parapper:test:coverage && bun run parapper:rust:fmt && bun run parapper:rust:lint && bun run parapper:rust:test && bun run rust:azookey:fmt && bun run rust:azookey:lint && bun run rust:azookey:test && bun run rust:input-lm:fmt && bun run rust:input-lm:lint && bun run rust:input-lm:test && bun run rust:vibrato:fmt && bun run rust:vibrato:lint && bun run rust:vibrato:test && bun run rust:wasm:fmt && bun run rust:wasm:lint && bun run rust:wasm:test && bun run rust:wasm:build && bun run rust:fmt && bun run rust:lint && bun run rust:desktop:test",
    "tauri": "bun --filter=@caption-bridge/desktop run tauri",
    "tauri:dev": "bun run dev",
    "tauri:build": "bun run sidecar:build && node scripts/run-tauri-build.mjs",
    "tauri:build:release": "bun run build:app:release"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6"
  }
}

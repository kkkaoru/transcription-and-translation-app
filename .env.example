# Cloudflare account selection for wrangler / Access automation.
# Keep the real token in the gitignored `.env`, never in wrangler.jsonc.
# Cursor MCP uses the Cloudflare plugin OAuth, not this token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional alias used by some local scripts.
# CLOUDFLARE_DEBUG_TOKEN=

# Cloudflare account selection for wrangler / Access automation.
# Keep the real token in the gitignored `.env`, never in wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional alias used by some local scripts. setup-cursor-cloudflare-mcp.mjs
# accepts either this or CLOUDFLARE_API_TOKEN.
# CLOUDFLARE_DEBUG_TOKEN=

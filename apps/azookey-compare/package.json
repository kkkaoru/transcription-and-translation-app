{
  "name": "@caption-bridge/azookey-compare",
  "version": "0.1.0",
  "private": true,
  "description": "WebSpeech and Worker AzooKey conversion comparison UI",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "biome check src",
    "format:check": "biome format src",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "build:worker": "NEXT_PUBLIC_AZOO_KEY_WORKER_WS_URL=wss://azookey-compare.kaoru.workers.dev/ws/azookey next build",
    "preview": "bun run build:worker && wrangler dev",
    "deploy": "bun run build:worker && wrangler deploy"
  },
  "dependencies": {
    "@caption-bridge/azookey-reading": "workspace:*",
    "@caption-bridge/dictionaries": "workspace:*",
    "next": "^15.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.28.1"
  }
}

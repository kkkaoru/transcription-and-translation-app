# Optional defaults for the comparison page. Values remain editable in the UI.
# App code already defaults to the local wrangler endpoint when this is unset:
#   ws://127.0.0.1:8787/ws/azookey
# Override here only when pointing at a deployed Worker (no production host is
# checked in; the Worker has not been deployed by default).
NEXT_PUBLIC_AZOO_KEY_WORKER_WS_URL=ws://127.0.0.1:8787/ws/azookey
# Optional browser-side convert/transform/tokenize pre-pass (not Vibrato/UniDic).
# Required once the browser pre-pass mode is selected in the UI.
NEXT_PUBLIC_AZOO_KEY_VIBRATO_WASM_URL=
NEXT_PUBLIC_AZOO_KEY_VIBRATO_WASM_GLOBAL=__AZOOKEY_VIBRATO_WASM__


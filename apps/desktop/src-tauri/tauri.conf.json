{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kotoba Beacon",
  "version": "0.1.0",
  "identifier": "com.kotobabeacon.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Kotoba Beacon",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local bilingual live captions for OBS by Kotoba Beacon",
    "externalBin": ["binaries/kotoba-inference-gateway"],
    "resources": {
      "infoplist/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "infoplist/ja.lproj/InfoPlist.strings": "ja.lproj/InfoPlist.strings"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "frameworks": ["./frameworks/Syphon.framework"]
    }
  }
}

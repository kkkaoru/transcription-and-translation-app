{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kotoba Beacon",
  "version": "0.1.1",
  "identifier": "com.kotobabeacon.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; child-src 'self' blob:; media-src 'self' blob:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Kotoba Beacon",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local bilingual live captions for OBS by Kotoba Beacon",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/kotoba-inference-gateway",
      "binaries/kotoba-parapper",
      "binaries/kotoba-zenz-server",
      "binaries/kotoba-llama-server"
    ],
    "resources": {
      "infoplist/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "infoplist/ja.lproj/InfoPlist.strings": "ja.lproj/InfoPlist.strings",
      "resources/macos-runtime": "macos-runtime",
      "resources/parapper-runtime": "parapper-runtime",
      "resources/zenz-runtime": "zenz-runtime",
      "resources/llama-runtime": "llama-runtime",
      "third-party/llama.cpp-MIT.txt": "third-party/llama.cpp-MIT.txt",
      "third-party/model-runtime-notice.md": "third-party/model-runtime-notice.md",
      "../../../packages/parapper-asr/LICENSE": "third-party/Parapper-ASR-LICENSE",
      "../../../packages/parapper-asr/CAPTION_BRIDGE_FORK.md": "third-party/Parapper-ASR-NOTICE.md",
      "../../../packages/parapper-asr/public/licenses/rust.json": "third-party/parapper-rust-licenses.json"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "frameworks": ["./frameworks/Syphon.framework"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMEM5MEI1QjU1MkE4MDAKUldRQXFGSzF0WkFNck1rc0FnRzlvZTBGVTRqOG44OFhJYzBGR0xhanVLc3g2WW5VMFlkeHg2YXEK",
      "endpoints": [
        "https://github.com/kkkaoru/transcription-and-translation-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

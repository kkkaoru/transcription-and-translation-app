<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The native capture path opens the selected microphone device. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!--
    Hardened Runtime's Library Validation only allows loading code signed by
    Apple or by the same Team ID as the main executable. The vendored
    Syphon.framework (apps/desktop/src-tauri/frameworks/Syphon.framework) is a
    third-party binary; unless every release step re-signs it with this app's
    own identity, Library Validation silently rejects
    `syphon_rs::Server::new`, native_output.rs falls back to
    "transparent-window", and OBS never sees a Syphon source. Disabling
    Library Validation is the standard, Apple-documented mitigation for
    hardened-runtime apps that bundle a non-Apple-signed framework (e.g. audio
    plugin hosts, Sparkle, Syphon-based capture tools).
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>

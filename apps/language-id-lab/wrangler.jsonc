{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotoba-beacon-language-id-lab",
  "account_id": "78109ec18c7c85b194b19fb32e3bb149",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "ai": { "binding": "AI" },
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "78109ec18c7c85b194b19fb32e3bb149"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "containers": [
    {
      "name": "speechbrain-ecapa-basic",
      "class_name": "SpeechbrainEcapaBasicContainer",
      "image": "../../crates/language-harness-service/Dockerfile",
      "image_build_context": "../../crates",
      "instance_type": "basic",
      "max_instances": 4,
      "constraints": { "regions": ["APAC"] }
    },
    {
      "name": "speechbrain-ecapa-standard",
      "class_name": "SpeechbrainEcapaStandardContainer",
      "image": "../../crates/language-harness-service/Dockerfile",
      "image_build_context": "../../crates",
      "instance_type": "standard-1",
      "max_instances": 4,
      "constraints": { "regions": ["APAC"] }
    },
    {
      "name": "nvidia-ambernet-basic",
      "class_name": "NvidiaAmbernetBasicContainer",
      "image": "../../crates/language-harness-service/Dockerfile.ambernet",
      "image_build_context": "../../crates",
      "instance_type": "basic",
      "max_instances": 4,
      "constraints": { "regions": ["APAC"] }
    },
    {
      "name": "nvidia-ambernet-standard",
      "class_name": "NvidiaAmbernetStandardContainer",
      "image": "../../crates/language-harness-service/Dockerfile.ambernet",
      "image_build_context": "../../crates",
      "instance_type": "standard-1",
      "max_instances": 4,
      "constraints": { "regions": ["APAC"] }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SPEECHBRAIN_ECAPA_BASIC", "class_name": "SpeechbrainEcapaBasicContainer" },
      { "name": "SPEECHBRAIN_ECAPA_STANDARD", "class_name": "SpeechbrainEcapaStandardContainer" },
      { "name": "NVIDIA_AMBERNET_BASIC", "class_name": "NvidiaAmbernetBasicContainer" },
      { "name": "NVIDIA_AMBERNET_STANDARD", "class_name": "NvidiaAmbernetStandardContainer" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-language-id-containers",
      "new_sqlite_classes": ["LanguageIdBasicContainer", "LanguageIdStandardContainer"]
    },
    {
      "tag": "v2-language-id-methods",
      "new_sqlite_classes": [
        "SpeechbrainEcapaBasicContainer",
        "SpeechbrainEcapaStandardContainer",
        "NvidiaAmbernetBasicContainer",
        "NvidiaAmbernetStandardContainer"
      ],
      "deleted_classes": ["LanguageIdBasicContainer", "LanguageIdStandardContainer"]
    }
  ]
}

{
  "name": "@caption-bridge/vad-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first browser VAD quality and performance laboratory",
  "scripts": {
    "copy:vad-assets": "bun scripts/copy-vad-assets.ts",
    "dev": "bun run copy:vad-assets && vite",
    "build": "bun run copy:vad-assets && vite build",
    "preview": "bun run build && vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "biome check src scripts vite.config.ts",
    "format:check": "biome format src scripts vite.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@ricky0123/vad-web": "0.0.30",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "d3": "7.9.0",
    "idb": "8.0.3",
    "onnxruntime-web": "1.27.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/d3": "7.4.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.8.4",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}

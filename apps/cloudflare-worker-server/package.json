{
  "name": "@caption-bridge/cloudflare-worker-server",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker adapter for the Caption Bridge inference HTTP contract",
  "type": "module",
  "scripts": {
    "build:wasm": "node ../../scripts/build-azookey-wasm.mjs",
    "dev": "bun run build:wasm && wrangler dev",
    "deploy": "bun run build:wasm && wrangler deploy",
    "pretypecheck": "bun run build:wasm",
    "typecheck": "tsc --pretty false --noEmit --project tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "pretest": "bun run build:wasm"
  },
  "dependencies": {
    "@caption-bridge/azookey-reading": "workspace:*",
    "@caption-bridge/inference-server-core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250718.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.28.1"
  }
}

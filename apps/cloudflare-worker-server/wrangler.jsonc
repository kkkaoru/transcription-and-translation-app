{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotoba-beacon-inference",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  // Public browser traffic goes through azookey-compare. Keep this workers.dev
  // hostname disabled so inference is only reachable via the service binding.
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Binding availability alone never selects this paid ASR path. Set the
  // secret/variable ASR_PROVIDER=workers-ai explicitly for a comparison.
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true
    }
  },
  // These are public, non-secret defaults. Keep CORS_ORIGIN pinned to one
  // explicit origin; override it at deploy time when the comparison UI has a
  // different, owned HTTPS origin. Never add API tokens to this file.
  "vars": {
    "CORS_ORIGIN": "https://azookey-compare.kaoru.workers.dev",
    "MODEL_ROUTES": "{\"zenz-v3.2-small-gguf\":{\"baseUrl\":\"https://zenz-gguf.kkk4oru.com\"}}",
    "AZOOKEY_TIMEOUT_MS": "2000",
    "AZOOKEY_DICTIONARY_URL": "/azookey/system.azkdict.gz",
    "VIBRATO_DICTIONARY_URL": "/vibrato/system.dic.zst"
  },
  // Names only: Wrangler can warn when local/prod secrets are missing, but
  // secret values are always entered through `wrangler secret put`.
  "secrets": {
    "required": ["AZOOKEY_API_TOKEN"]
  },
  // SQLite Durable Object for the hosted compare user lexicon.
  // Binding: USER_LEXICON. Isolated with idFromName("hosted-compare").
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_LEXICON",
        "class_name": "UserLexiconDO"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "USER_LEXICON_IMPORTS",
      "bucket_name": "azookey-user-lexicon-imports"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "USER_LEXICON_IMPORT_QUEUE",
        "queue": "azookey-user-lexicon-imports"
      }
    ],
    "consumers": [
      {
        "queue": "azookey-user-lexicon-imports",
        "max_batch_size": 1,
        "max_retries": 5
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-user-lexicon",
      "new_sqlite_classes": ["UserLexiconDO"]
    }
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["wasm/*.wasm"],
      "fallthrough": true
    }
  ]
}

# Copy this file to `.dev.vars` for local-only overrides. `.dev.vars` is
# ignored by git; do not rename it to a tracked `.env` file.
#
# Production secrets belong in Cloudflare's encrypted secret store. Set them
# with `wrangler secret put AZOOKEY_API_TOKEN` (and, when needed,
# `wrangler secret put ASR_API_TOKEN`); never put token values in this file,
# wrangler.jsonc, or shell history.

# The comparison app's local Next.js server runs on port 3000 by default.
CORS_ORIGIN=http://127.0.0.1:3000

# Keep this `{}` unless HTTP chat / Zenzai routing is intentionally enabled.
# Local compare defaults (desktop model_runtime ports):
# MODEL_ROUTES={"zenz-v3.2-xsmall-gguf":{"baseUrl":"http://127.0.0.1:8081"},"zenz-v3.2-small-gguf":{"baseUrl":"http://127.0.0.1:8082"}}
MODEL_ROUTES={}

# Optional: enables remote ASR proxying. The upstream must implement
# POST /v1/audio/transcriptions with the same OpenAI-shaped contract.
# Set ASR_UPSTREAM_URL here in the untracked file to your owned HTTPS endpoint.

# Optional comparison/fallback: use Cloudflare Workers AI's
# @cf/deepgram/nova-3 Japanese ASR only when this is explicitly enabled. The
# Wrangler AI binding may be enabled, but this provider flag is omitted by
# default; leave it unset to preserve the configured upstream/503 behavior.
# Workers AI is metered and sends audio to Cloudflare/Deepgram, so review cost
# and privacy before use.
# ASR_PROVIDER=workers-ai
# WORKERS_AI_ASR_TIMEOUT_MS=15000

# Required for Tauri-parity conversion quality. Without this URL the WASM
# converter falls back to the tiny built-in lexicon and accuracy collapses.
AZOOKEY_DICTIONARY_URL=/azookey/system.azkdict.gz

# Direct Worker Vibrato WASM is not enabled with the portable AzooKey asset:
# the IPADIC tokenizer exceeds the Workers isolate memory limit. For a real
# server-side pre-pass configure an owned HTTPS adapter instead. The browser
# comparison mode uses the generated Vibrato WASM locally.

# Optional server-side Vibrato adapter. It must accept POST
# {"text":"...","language":"..."} and return {"text":"..."} (hiragana).
# If this endpoint needs a bearer, set VIBRATO_API_TOKEN only as a secret with
# `wrangler secret put VIBRATO_API_TOKEN`.
# Set VIBRATO_UPSTREAM_URL in this untracked file to your owned HTTPS endpoint.

# Optional local tuning (25–2,000 ms; defaults to 1,000).
AZOOKEY_TIMEOUT_MS=2000

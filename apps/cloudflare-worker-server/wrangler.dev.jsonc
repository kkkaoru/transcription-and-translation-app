{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotoba-beacon-inference",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Local AzooKey stays on :8787. Workers AI has no local simulation; remote: true
  // calls Cloudflare AI without wrangler dev --remote, so a timeout fails the ASR
  // request instead of taking down the WebSocket listener.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ORIGIN": "https://kotoba-beacon-inference.kaoru.workers.dev",
    "MODEL_ROUTES": "{}",
    "AZOOKEY_TIMEOUT_MS": "2000",
    "AZOOKEY_DICTIONARY_URL": "/azookey/system.azkdict.gz"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["wasm/*.wasm"],
      "fallthrough": true
    }
  ]
}

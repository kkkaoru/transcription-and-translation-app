{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotoba-beacon-inference",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Local AzooKey/Web Speech comparison does not use Workers AI. The deploy
  // config keeps the AI binding, but wrangler dev with that binding opens a
  // remote Cloudflare session; when api.cloudflare.com times out the local
  // :8787 listener dies and the compare UI reports a WebSocket connection error.
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ORIGIN": "https://kotoba-beacon-inference.kaoru.workers.dev",
    "MODEL_ROUTES": "{}",
    "AZOOKEY_TIMEOUT_MS": "2000",
    "AZOOKEY_DICTIONARY_URL": "/azookey/system.azkdict.gz"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["wasm/*.wasm"],
      "fallthrough": true
    }
  ]
}
